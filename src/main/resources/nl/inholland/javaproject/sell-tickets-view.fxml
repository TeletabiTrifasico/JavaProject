<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nl.inholland.javaproject.SellTicketsController">
    <Label text="Sell Tickets" style="-fx-font-size: 24px; -fx-font-weight: bold;" alignment="CENTER" />

    <HBox spacing="10">
        <Label text="Select showing: " />
        <ComboBox fx:id="showingsComboBox" promptText="Select a movie showing" prefWidth="300" />
    </HBox>

    <Label fx:id="selectedShowingLabel" text="Selected showing: " visible="false" />
    <Label fx:id="availableSeatsLabel" text="Available seats: " />

    <HBox spacing="20">
        <VBox spacing="10" alignment="CENTER">
            <Label text="-----------------------Viewscreen-----------------------" />
            <GridPane fx:id="seatsGrid" hgap="5" vgap="5" alignment="CENTER"/>
        </VBox>
        <VBox spacing="10">
            <Label text="Selected seats:" />
            <ListView fx:id="selectedSeatsList" prefHeight="150" />
        </VBox>
    </HBox>

    <TextField fx:id="customerNameField" promptText="Customer name" />

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="sellTicketsButton" text="Sell Tickets" onAction="#onSellTicketsClick" disable="true" />
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancelClick" />
    </HBox>
</VBox>